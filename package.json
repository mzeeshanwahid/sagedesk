{
  "name": "sagedesk",
  "version": "1.0.0",
  "description": "RAG-powered support widget for any website. Local mode: in-browser search with no API key. LLM mode: synthesized answers via your own backend.",
  "type": "module",
  "author": {
    "name": "Muhammad Zeeshan",
    "email": "mzeeshanwa@gmail.com",
    "url": "https://www.mzeeshan.dev"
  },
  "exports": {
    ".": {
      "types": "./dist/vanilla/index.d.ts",
      "import": "./dist/vanilla/index.js",
      "require": "./dist/vanilla/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "import": "./dist/next/index.js",
      "require": "./dist/next/index.cjs"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.cjs"
    }
  },
  "bin": {
    "sagedesk": "./dist/cli/index.cjs"
  },
  "files": [
    "dist",
    "README.md",
    "knowledge.example.json"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "dompurify": "^3.0.9",
    "marked": "^13.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^1.6.1",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "jsdom": "^29.1.1",
    "next": "^14.0.0",
    "ora": "^7.0.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vite": "^8.0.10",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "next": ">=13.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "keywords": [
    "chat",
    "widget",
    "rag",
    "support",
    "wasm",
    "webassembly",
    "semantic-search",
    "local-ai",
    "no-api-key",
    "chatbot",
    "support-widget",
    "help-widget",
    "faq",
    "knowledge-base",
    "vector-search",
    "embeddings",
    "transformers",
    "offline",
    "privacy",
    "react",
    "nextjs",
    "vanilla-js",
    "web-component",
    "floating-chat",
    "customer-support",
    "ai",
    "nlp"
  ],
  "license": "MIT",
  "homepage": "https://github.com/mzeeshanwahid/sagedesk#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/mzeeshanwahid/sagedesk.git"
  },
  "bugs": {
    "url": "https://github.com/mzeeshanwahid/sagedesk/issues"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "sideEffects": false
}
